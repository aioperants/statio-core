# Postgres connection string (Neon via the Vercel Marketplace sets this automatically)
DATABASE_URL=postgres://postgres@localhost:5432/statio
# Optional: a separate owner login used only by migrations (DATABASE_URL can then be a smaller role)
MIGRATION_DATABASE_URL=

# Public address of this salon, e.g. https://book.salonname.com
BETTER_AUTH_URL=http://localhost:3000
# Random 32+ character string: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# Email of the salon owner; signing in with it creates the owner account
OWNER_EMAIL=owner@example.com

# Google and Microsoft sign-in (leave empty to hide the button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Email sending (optional; can also be set in the app under Settings › Email, which wins).
# Resend, or any SMTP server (own mailbox, Brevo, Postmark, SES…). Without either, emails are printed to the server log.
EMAIL_PROVIDER=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Salon <bookings@example.com>"

# Websites allowed to embed the booking page, space separated
EMBED_ALLOWED_ORIGINS=

# Cloudflare Turnstile bot check (optional in development)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Notifications on the team's phones, free. Off until set: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Statio Core tells the Statio team it's running: once at setup and weekly (an anonymous id, the
# version, country and language; your email only if you tick "Email me about updates"). Turn it off:
# STATIO_TELEMETRY=off
