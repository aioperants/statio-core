{
  "name": "statio-core",
  "version": "0.1.0",
  "private": true,
  "description": "Statio Core: an open-source website, online booking and client book (CRM) for one beauty salon, barber or spa",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "tsx --env-file-if-exists=.env node_modules/vitest/vitest.mjs run src/db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "vercel-build": "tsx scripts/migrate.ts && next build",
    "services:import": "tsx --env-file-if-exists=.env scripts/import-services.ts"
  },
  "dependencies": {
    "better-auth": "1.7.10",
    "date-holidays": "3.37.0",
    "drizzle-orm": "0.45.4",
    "libphonenumber-js": "1.12.25",
    "next": "16.4.1",
    "next-intl": "4.14.9",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.34.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "license": "Apache-2.0"
}
